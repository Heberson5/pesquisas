{
  "name": "pesquisa-satisfacao",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de pesquisa de satisfação (NPS) para várias empresas, com modo quiosque para tablets",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "create-master": "node --disable-warning=ExperimentalWarning scripts/create-master.js",
    "create-company": "node --disable-warning=ExperimentalWarning scripts/create-company.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "rotate-secret": "node --disable-warning=ExperimentalWarning scripts/rotate-secret.js",
    "manual:prints": "node --disable-warning=ExperimentalWarning scripts/manual-screenshots.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.1.6",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
