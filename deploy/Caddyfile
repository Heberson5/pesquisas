{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		# Com Cloudflare na frente (docs/SEGURANCA.md), troque a linha acima por:
		# header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		# e libere as portas 80/443 só para os IPs da Cloudflare no firewall.
	}
}
