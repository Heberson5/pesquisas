# ============================================================================
# Pesquisa de satisfação — configuração de PRODUÇÃO
# Copie para .env (cp .env.example .env), preencha e proteja: chmod 600 .env
# NUNCA envie o .env para o GitHub (já está no .gitignore).
# ============================================================================

# Endereço público (usado em links de e-mail e QR Codes). Obrigatório, com https.
PUBLIC_URL=https://pesquisa.sauberlich.com.br

# Chave mestra: criptografa dados pessoais e o 2FA. Gere UMA vez e guarde em local seguro:
#   openssl rand -base64 48
# Se perder esta chave, contatos e 2FA já gravados ficam ilegíveis. Para TROCAR, use a rotação (docs/SEGURANCA.md).
APP_SECRET=

# Só para o modo com Caddy (docker-compose.caddy.yml)
DOMAIN=pesquisa.sauberlich.com.br
ACME_EMAIL=ti@sauberlich.com.br

# Fuso horário da empresa (relatórios, campanhas, horário das filiais)
TZ_EMPRESA=America/Sao_Paulo

# E-mail e WhatsApp também podem ser configurados no painel (Configurações → E-mail e WhatsApp),
# com senha/token criptografados. O que for salvo no painel tem prioridade sobre as variáveis abaixo.
# E-mail (SMTP). Ex.: Google Workspace (smtp.gmail.com:587 com senha de app),
# Microsoft 365 (smtp.office365.com:587), Amazon SES, Brevo, Mailgun...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pesquisa de Satisfação <pesquisa@sauberlich.com.br>"

# WhatsApp (opcional) — API oficial da Meta (WhatsApp Business Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Backup diário (03:00): quantos dias manter
BACKUP_KEEP_DAYS=14
# Frase para CRIPTOGRAFAR os backups (mín. 16 caracteres). Recomendado: com ela, os arquivos podem ir para fora
# do servidor (nuvem/outro disco) sem expor dados. Guarde-a fora do servidor — sem ela o backup não abre.
BACKUP_PASSPHRASE=

# Rotação da chave mestra (só durante a troca; veja docs/SEGURANCA.md):
# APP_SECRET_PREVIOUS=

# Mercado Pago: o normal é configurar pelo painel do Master (fica criptografado). Opcional aqui:
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
